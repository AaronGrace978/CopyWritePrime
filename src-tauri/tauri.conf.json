{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CopyWritePrime",
  "version": "0.3.0",
  "identifier": "com.copywriteprime.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CopyWritePrime",
        "width": 1480,
        "height": 940,
        "minWidth": 1120,
        "minHeight": 720,
        "decorations": false,
        "resizable": true,
        "center": true,
        "backgroundColor": "#12110e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "AI writing studio that flows with you",
    "longDescription": "CopyWritePrime is a desktop writing studio: ghost-text flow, prompt-to-prose, brand compliance rails, every major model provider, and one-click Word export.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
